    "people-stay": {
      "id": "people-stay",
      "narrationKo": "룻의 목소리가 떨리지만 단단합니다.",
      "reply": {
        "mode": "blocks",
        "promptKo": "고백을 이어 가세요. '당신의 백성이 나의 백성'",
        "tokens": [
          "עַמִּי",
          "עַמֵּךְ",
          "אֱלֹהָי"
        ],
        "accepted": [
          "עַמֵּךְ עַמִּי"
        ],
        "next": "end",
        "lemmaIds": [
          "H5971"
        ]
      }
    },
    "end": {
      "id": "end",
      "narrationKo": "나오미는 룻이 굳게 결심한 것을 보고 더 말하지 않았습니다(룻 1:18). 미션 완료!",
      "end": true
    }
