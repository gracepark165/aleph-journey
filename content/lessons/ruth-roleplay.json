  "nodes": {
    "intro": {
      "id": "intro",
      "narrationKo": "나오미가 말합니다. \"내 딸아, 너도 네 백성에게로 돌아가거라.\"",
      "reply": {
        "mode": "choice",
        "options": [
          {
            "id": "dont",
            "line": {
              "he": "אַל תִּפְגְּעִי בִי",
              "translit": "알 티프게이 비",
              "ko": "저에게 강권하지 마세요.",
              "lemmaIds": [
                "H408",
                "H6293",
                "H9002"
              ]
            },
            "correct": true,
            "next": "follow"
          },
          {
            "id": "return",
            "line": {
              "he": "לָשׁוּב",
              "translit": "라슈브",
              "ko": "돌아가라고",
              "lemmaIds": [
                "H7725"
              ]
            },
            "correct": false,
            "feedbackKo": "'돌아가라고'는 나오미의 권유예요. 룻은 반대로 대답했어요."
          },
          {
            "id": "god",
            "line": {
              "he": "אֱלֹהָי",
              "translit": "엘로하이",
              "ko": "나의 하나님",
              "lemmaIds": [
                "H430"
              ]
            },
            "correct": false,
            "feedbackKo": "좋은 고백이지만 아직 이르러요. 먼저 강권하지 말아 달라고 해 보세요."
          }
        ]
      }
    },
    "follow": {
      "id": "follow",
      "narrationKo": "나오미가 조용히 룻을 바라봅니다.",
