            "line": {
              "he": "אֶל אֲשֶׁר תֵּלְכִי אֵלֵךְ",
              "translit": "엘 아셰르 텔레키 엘레크",
              "ko": "어머니가 가시는 곳에 저도 가겠어요.",
              "lemmaIds": [
                "H3212",
                "H413",
                "H834"
              ]
            },
            "correct": true,
            "next": "people"
          },
          {
            "id": "stay",
            "line": {
              "he": "וּבַאֲשֶׁר תָּלִינִי אָלִין",
              "translit": "우바아셰르 탈리니 알린",
              "ko": "어머니가 머무시는 곳에 저도 머물겠어요.",
              "lemmaIds": [
                "H3885",
                "H834"
              ]
            },
            "correct": true,
            "next": "people-stay"
          },
          {
            "id": "leave",
            "line": {
              "he": "לְעָזְבֵךְ",
              "translit": "레오즈베크",
              "ko": "당신을 떠나라고",
              "lemmaIds": [
                "H5800"
              ]
            },
            "correct": false,
            "feedbackKo": "'당신을 떠나라고'예요. 룻은 떠나지 않겠다고 했지요."
          }
        ]
      }
