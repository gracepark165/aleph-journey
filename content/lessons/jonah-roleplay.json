{
  "id": "jonah-roleplay",
  "type": "roleplay",
  "titleKo": "미션: 선원들에게 정체를 밝혀라",
  "setupKo": "당신은 요나입니다. 다시스로 가는 배에 탔는데, 큰 폭풍이 몰아칩니다. 선원들이 당신을 흔들어 깨워요.",
  "character": {
    "nameKo": "선원들",
    "nameHe": "מַלָּחִים"
