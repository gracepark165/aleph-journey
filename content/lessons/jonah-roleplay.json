  "startNodeId": "intro",
  "nodes": {
    "intro": {
      "id": "intro",
      "npc": {
        "he": "מַה מְּלַאכְתְּךָ וּמֵאַיִן תָּבוֹא",
        "translit": "마 멜라크테카 우메아인 타보",
        "ko": "네 일은 무엇이며, 어디에서 왔느냐?",
