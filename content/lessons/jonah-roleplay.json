                "H3004",
                "H3220",
                "H6213",
                "H834",
                "H853"
              ]
            },
            "correct": true,
            "next": "end"
          },
          {
            "id": "evil",
            "line": {
              "he": "הָרָעָה הַזֹּאת",
              "translit": "하라아 하조트",
              "ko": "이 재앙",
              "lemmaIds": [
                "H2063",
                "H7451"
              ]
            },
            "correct": false,
            "feedbackKo": "재앙이 아니라 하나님이 무엇을 지으셨는지 말해 보세요."
          }
        ]
      }
    },
    "end": {
      "id": "end",
      "narrationKo": "선원들은 크게 두려워했습니다(욘 1:10). 이야기는 큰 물고기로 이어져요. 미션 완료!",
      "end": true
    }
  }
