          "H370",
          "H4100",
          "H4399",
          "H935"
        ]
      },
      "reply": {
        "mode": "choice",
        "options": [
          {
            "id": "hebrew",
            "line": {
              "he": "עִבְרִי אָנֹכִי",
              "translit": "이브리 아노키",
              "ko": "나는 히브리 사람입니다.",
              "lemmaIds": [
                "H5680",
                "H595"
              ]
            },
            "correct": true,
            "next": "fear"
          },
          {
            "id": "haran",
            "line": {
              "he": "מֵחָרָן אֲנָחְנוּ",
              "translit": "메하란 아나흐누",
              "ko": "우리는 하란에서 왔소",
              "lemmaIds": [
                "H2771",
                "H587"
              ]
            },
            "correct": false,
            "feedbackKo": "그건 야곱이 만난 목자들의 대답이에요."
          },
          {
            "id": "peace",
            "line": {
              "he": "שָׁלוֹם",
              "translit": "샬롬",
              "ko": "평안",
              "lemmaIds": [
                "H7965"
              ]
            },
            "correct": false,
            "feedbackKo": "폭풍 한가운데서 \"평안\"이라니요! 정체를 밝혀 보세요."
          }
        ]
      }
    },
    "fear": {
      "id": "fear",
      "npc": {
        "he": "וְאֵי מִזֶּה עַם אָתָּה",
        "translit": "베에이 미제 암 아타",
        "ko": "너는 어느 민족이냐?",
        "lemmaIds": [
          "H2088",
          "H335",
          "H5971",
          "H859"
        ]
      },
      "reply": {
        "mode": "blocks",
        "promptKo": "누구를 경외하는지 말하세요. '나는 경외합니다'",
        "tokens": [
          "יָרֵא",
          "אֲנִי",
          "הַיָּם"
        ],
        "accepted": [
          "אֲנִי יָרֵא"
        ],
        "next": "maker",
        "lemmaIds": [
          "H3373",
          "H589"
        ]
      }
    },
    "maker": {
      "id": "maker",
